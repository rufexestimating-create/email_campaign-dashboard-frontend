# Copy to .env.local for local development. On Netlify, set these in Site configuration -> Environment variables.

# Backend API address (FastAPI on Render), ending in /api/v1
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Company name shown in the app (optional, default "Arvistry")
NEXT_PUBLIC_BRAND_NAME=Arvistry
